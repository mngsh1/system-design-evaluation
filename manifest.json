{
  "manifest_version": 3,
  "name": "System Design Interview Copilot",
  "version": "1.0.0",
  "author": "Mangesh Chimankar",
  "description": "AI-powered System Design Interview Copilot with interactive architecture canvas, deep dives, and stage-by-stage FAANG evaluation.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "System Design Interview Copilot"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "prompts/*",
        "app/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
